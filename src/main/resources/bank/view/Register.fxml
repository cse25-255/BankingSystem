<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bank.controller.RegisterController">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Label text="Register a new customer" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
      <TextField fx:id="firstNameField" promptText="First name" />
      <TextField fx:id="surnameField" promptText="Surname" />
      <TextField fx:id="addressField" promptText="Address" />
      <TextField fx:id="phoneField" promptText="Phone number (8 digits)" />
      <PasswordField fx:id="pinField" promptText="PIN (4 digits)" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button text="Register" onAction="#handleRegister" />
            <Button text="Back to login" onAction="#goToLogin" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" style="-fx-text-fill: red;" />
   </children>
</VBox>